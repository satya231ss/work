const items = $input.all();

const result = {};

for (const item of items) {

  const row = item.json;

  const site = String(
    row.SITE ??
    row.site ??
    row.site_code ??
    ''
  ).trim();

  if (!site) continue;

  const phase = String(
    row.Phase ??
    row.phase ??
    ''
  ).trim();

  if (!result[site]) {
    result[site] = {
      SITE: site,
      P2: 0,
      P3: 0,
      Scrap: 0,
      Total: 0
    };
  }

  const total = Number(
    row.TOTAL ??
    row.total ??
    1
  );

  if (phase === 'P2') {
    result[site].P2 += total;
  }

  if (phase === 'P3') {
    result[site].P3 += total;
  }

  if (phase === 'Scrap') {
    result[site].Scrap += total;
  }

  result[site].Total += total;
}

return Object.values(result)
  .sort((a, b) => a.SITE.localeCompare(b.SITE))
  .map(row => ({
    json: row
  }));